{
  "name": "context-budgeter",
  "version": "0.1.0",
  "description": "Fit a chat message history into a model's context window — a tiny, zero-dependency, tokenizer-agnostic trimmer with pluggable strategies (keep-system, drop-oldest, middle-out, summarize) and a guarantee it never exceeds the budget or drops a pinned message.",
  "type": "module",
  "license": "MIT",
  "author": "Himanshu Sharma",
  "sideEffects": false,
  "keywords": [
    "llm",
    "ai",
    "context-window",
    "tokens",
    "trim",
    "truncate",
    "chat",
    "messages",
    "prompt",
    "openai",
    "anthropic",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H1manshu01/context-budgeter.git"
  },
  "homepage": "https://github.com/H1manshu01/context-budgeter#readme",
  "bugs": {
    "url": "https://github.com/H1manshu01/context-budgeter/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js",
      "require": "./dist/models.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^6.4.4"
  },
  "size-limit": [
    {
      "name": "core (fit + fitAsync)",
      "path": "dist/index.js",
      "limit": "2 kB"
    },
    {
      "name": "models (estimate + registry)",
      "path": "dist/models.js",
      "limit": "2 kB"
    }
  ],
  "engines": {
    "node": ">=18"
  }
}
